# Bongabong VMS - Apache configuration (works on XAMPP and Hostinger)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Tells config.php that pretty URLs like /Register are available.
    SetEnv VMS_REWRITE 1

    # Work out the folder the app is installed in, so it also runs in a
    # subfolder such as /vms-bongabong without further edits.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^index\.php$ - [L]
    RewriteRule ^(.*)$ index.php?r=$1 [QSA,L]
</IfModule>

# Never serve the config or the seed data directly.
<FilesMatch "^(config|config\.local|config\.local\.example|seed_data|db|auth|helpers)\.php$">
    Require all denied
</FilesMatch>

# The site is deployed by `git pull`, so public_html contains a .git directory.
# Served unprotected it hands out the full source history - and any credential
# ever committed by mistake. Deny it, and the deploy script alongside it.
RedirectMatch 404 /\.git(/|$)

<FilesMatch "^(\.gitignore|deploy-hostinger\.sh|deploy-local\.cmd|start-local.bat|build-zip.ps1|.*\.md)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------- caching --
#
# The lobby kiosk is a touch screen with no keyboard, so nobody standing in
# front of it can force a refresh. Nothing that can go stale may be cached by
# time: the rule this replaces held css and js for seven days, which meant a
# deploy could take a week to reach that screen.
#
# Freshness is handled two ways instead. Every stylesheet, script and the hero
# image is requested with ?v=<mtime> (asset_url() in includes/helpers.php), so
# the URL changes whenever the file does; and what is left revalidates on each
# use, which costs a 304 and nothing more.
#
#   pages         never cached - they carry the current ?v= stamps
#   sw.js         never cached - a stale worker outlives everything else
#   fonts         cached for a year - they only change by getting a new name
#   css/js/images revalidated every time, so a changed file is never missed

<IfModule mod_headers.c>
    # Every page is generated by PHP and names the current build.
    <FilesMatch "\.php$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
    </FilesMatch>

    <FilesMatch "\.woff2$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(css|js|png|svg|webmanifest)$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # The service worker decides what every other request may do, which makes a
    # stale one the hardest kind to clear. Browsers revalidate it; say so anyway.
    <FilesMatch "^sw\.js$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>

# mod_expires would put time-based caching back on top of the rules above.
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>

DirectoryIndex index.php
